{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/meta-llama/llama-3.1-8b-instruct:free"
      }
    },
    "list": [
      {
        "id": "lobster_red",
        "name": "Lobster Red",
        "workspace": "/root/.openclaw/workspaces/red",
        "agentDir": "/root/.openclaw/agents/lobster_red",
        "model": {
          "primary": "openrouter/meta-llama/llama-3.1-8b-instruct:free"
        },
        "identity": {
          "name": "Lobster Red",
          "theme": "laid-back data lobster",
          "emoji": "🔴"
        },
        "groupChat": {
          "mentionPatterns": ["Red:", "red:", "@lobster_red_bot", "Red,", "red,"]
        },
        "tools": {
          "profile": "messaging",
          "deny": ["browser", "exec", "write", "edit", "canvas", "nodes", "cron"]
        }
      },
      {
        "id": "lobster_yellow",
        "name": "Lobster Yellow",
        "workspace": "/root/.openclaw/workspaces/yellow",
        "agentDir": "/root/.openclaw/agents/lobster_yellow",
        "model": {
          "primary": "openrouter/meta-llama/llama-3.1-8b-instruct:free"
        },
        "identity": {
          "name": "Lobster Yellow",
          "theme": "analytical lobster",
          "emoji": "🟡"
        },
        "groupChat": {
          "mentionPatterns": ["Yellow:", "yellow:", "@lobster_yellow_bot", "Yellow,", "yellow,"]
        },
        "tools": {
          "profile": "messaging",
          "deny": ["browser", "exec", "write", "edit", "canvas", "nodes", "cron"]
        }
      },
      {
        "id": "lobster_green",
        "name": "Lobster Green",
        "workspace": "/root/.openclaw/workspaces/green",
        "agentDir": "/root/.openclaw/agents/lobster_green",
        "model": {
          "primary": "openrouter/meta-llama/llama-3.1-8b-instruct:free"
        },
        "identity": {
          "name": "Lobster Green",
          "theme": "bank lobster",
          "emoji": "🟢"
        },
        "groupChat": {
          "mentionPatterns": ["Green:", "green:", "@lobster_green_bot", "Green,", "green,"]
        },
        "tools": {
          "profile": "messaging",
          "deny": ["browser", "exec", "write", "edit", "canvas", "nodes", "cron"]
        }
      }
    ]
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "accounts": {
        "red": {
          "name": "Lobster Red",
          "botToken": "${TELEGRAM_BOT_TOKEN_RED}"
        },
        "yellow": {
          "name": "Lobster Yellow",
          "botToken": "${TELEGRAM_BOT_TOKEN_YELLOW}"
        },
        "green": {
          "name": "Lobster Green",
          "botToken": "${TELEGRAM_BOT_TOKEN_GREEN}"
        }
      },
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },

  "session": {
    "scope": "per-sender"
  },

  "env": {
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
    "BACKEND_URL": "http://127.0.0.1:8000"
  }
}
