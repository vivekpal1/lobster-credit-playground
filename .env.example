# --- Telegram Bot Tokens (used by OpenClaw, not FastAPI) ------------------
TELEGRAM_BOT_TOKEN_RED=your-red-bot-token
TELEGRAM_BOT_TOKEN_YELLOW=your-yellow-bot-token
TELEGRAM_BOT_TOKEN_GREEN=your-green-bot-token

# --- LLM (used by OpenClaw, not FastAPI) ----------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Backend URL (OpenClaw skills call this to reach FastAPI) -------------
BACKEND_URL=http://localhost:8000

# --- Solana Devnet (used by FastAPI /settle) ------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SETTLEMENT_PRIVATE_KEY=

# --- Ledger DB (used by FastAPI) ------------------------------------------
LEDGER_DB_PATH=./ledger.db
