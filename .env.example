# --- LLM (OpenRouter) -----------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Telegram Bot Tokens --------------------------------------------------
# Create three bots via @BotFather on Telegram.
TELEGRAM_BOT_TOKEN_RED=your-red-bot-token
TELEGRAM_BOT_TOKEN_YELLOW=your-yellow-bot-token
TELEGRAM_BOT_TOKEN_GREEN=your-green-bot-token

# --- Solana Devnet --------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 private key or JSON array (from solana-keygen).
SOLANA_SETTLEMENT_PRIVATE_KEY=

# --- Ledger DB ------------------------------------------------------------
LEDGER_DB_PATH=./ledger.db

# --- API Base URL (used by OpenClaw skills to reach this service) ---------
LEDGER_API_BASE=http://localhost:8000
